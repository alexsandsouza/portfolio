rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção de ranking de atividades — acesso público (Somente leitura e inserção)
    match /fametro_ranking/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'score']) &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() < 60 &&
                       request.resource.data.score is number;
      allow update, delete: if false;
    }
    // Coleção de perfil comportamental — alunos escrevem, todos leem
    match /perfil_comportamental/{doc} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
